<div class="container mx-auto px-4 mt-8">
  <div class="flex flex-col items-center gap-4 text-center mb-16">
    <h1 class="text-3xl font-bold text-gray-900"><%= t("documentations.title") %></h1>
    <p class="text-gray-600"><%= t("documentations.subtitle") %></p>
  </div>
  <ul class="max-w-4xl mx-auto">
    <% DocumentationPage.for_tag(params[:tag]).each do |page| %>
      <li class="py-4 border-b border-gray-200 last:border-0">
        <div class="flex justify-between items-center">
          <div class="flex flex-col gap-2 w-full">
            <div class="flex items-center flex-wrap gap-2">
              <% page.tags.each do |tag| %>
                <%= link_to tag, page_path(:documentations, tag: tag), class: "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-teal-50 text-teal-700 border border-teal-200" %>
              <% end %>
            </div>
            <%= link_to page.title, page.request_path, class: "text-teal-600 hover:text-teal-800 text-xl font-medium mt-2 mb-2" %>
            <p class="text-gray-600"><%= page.description %></p>
            <%= link_to t("documentations.read_more"), page.request_path, class: "text-primary hover:text-purple-800 text-sm font-medium mt-2" %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
