<%= render "shared/breadcrumbs", current: "Subscription" %>

<div class="max-w-2xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">Subscription Status</h1>
  <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 mb-6">
    <p class="text-gray-600"><strong class="text-gray-900">Email:</strong> <%= @user.email %></p>
    <p class="text-gray-600"><strong class="text-gray-900">Trial Active:</strong> <%= @user.trial_active? ? "Yes (ends #{ @user.trial_ends_at.strftime('%B %d, %Y') })" : "No" %></p>
    <p class="text-gray-600"><strong class="text-gray-900">Subscribed:</strong> <%= @user.subscribed? ? "Yes" : "No" %></p>
  </div>

  <% unless @user.subscribed? %>
    <div>
      <h2 class="text-lg font-medium text-gray-900 mb-4">Available Plans</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @plans.each do |plan| %>
          <div class="bg-gray-50 rounded-lg border border-gray-200 p-4">
            <h3 class="text-lg font-semibold text-gray-900"><%= plan.name %></h3>
            <p class="text-2xl font-bold text-primary mt-1">$<%= plan.price_in_dollars %>/<%= plan.interval %></p>
            <p class="text-sm text-gray-500 mt-2"><%= plan.features %></p>
            <% if plan.name == "Free" %>
              <p class="text-green-600 font-medium mt-2">Current Plan</p>
            <% else %>
              <%= button_to "Subscribe", subscriptions_path(plan_id: plan.id), method: :post, class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition mt-4" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <%= link_to "Back to Dashboard", dashboard_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
  </div>
</div>
