<div class="flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <%= image_tag asset_path("drafteasylogo.png"), alt: "DraftEasy Logo", class: "h-16 mx-auto mb-4" %>
      <h1 class="text-2xl font-bold text-gray-900">Welcome Back</h1>
      <p class="text-gray-500 mt-1">Sign in to your account</p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
      <%= form_with(url: sign_in_path, class: "flex flex-col gap-4") do |form| %>
        <div>
          <%= form.ui_email_field :email, tabindex: 1, label: false, placeholder: t("email"), required: true, autofocus: true %>
        </div>
        <div>
          <div class="flex justify-end mb-1">
            <%= link_to t("forgot_password"), new_identity_password_reset_path, tabindex: 3, class: "text-sm text-primary hover:text-purple-800" %>
          </div>
          <%= form.ui_password_field :password, tabindex: 2, label: false, placeholder: t("password"), required: true, autocomplete: "current-password" %>
        </div>
        <%= form.ui_submit t("sign_in"), tabindex: 4, class: "w-full bg-primary text-white py-2.5 px-4 rounded-md hover:bg-purple-800 transition font-medium mt-2", id: :sign_in %>
      <% end %>
    </div>

    <div class="mt-6 text-center text-sm text-gray-600">
      <%= t(".no_account_yet") %>
      <%= link_to t("sign_up"), sign_up_path, class: "text-primary hover:text-purple-800 font-medium ml-1" %>
    </div>
  </div>
</div>
