<%= render "shared/breadcrumbs", current: "Deadlines" %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">Case Deadlines</h1>

  <% if @cases.any? %>
    <div class="space-y-3">
      <% @cases.each do |case_record| %>
        <div class="bg-white rounded-lg border border-gray-200 p-4 flex justify-between items-center">
          <div>
            <h3 class="font-medium text-gray-900"><%= link_to case_record.case_name, case_path(case_record), class: "text-primary hover:text-purple-800" %></h3>
            <p class="text-sm text-gray-500">Deadline: <%= case_record.deadline.strftime('%B %d, %Y') %></p>
            <p class="text-sm text-gray-500">Days remaining: <%= (case_record.deadline - Date.today).to_i %></p>
          </div>
          <% if case_record.deadline < Date.today %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Overdue</span>
          <% elsif case_record.deadline < Date.today + 7 %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Due Soon</span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">On Track</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No cases with deadlines set.</p>
  <% end %>

  <div class="mt-8">
    <%= link_to "Back to Cases", cases_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
  </div>
</div>
