<!-- Breadcrumbs -->
<nav class="mb-6">
  <div class="card bg-base-200 shadow-sm p-2">
    <ul class="breadcrumbs flex items-center gap-2 text-sm m-0">
      <li><%= link_to 'Dashboard', dashboard_path, class: 'link link-hover' %></li>
      <li><svg class="inline w-4 h-4 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
      <li class="text-primary font-semibold">Deadlines</li>
    </ul>
  </div>
</nav>

<div class="max-w-4xl mx-auto mt-10 p-8 bg-base-100 rounded-lg shadow">
  <h1 class="text-2xl font-bold mb-6">Case Deadlines</h1>
  <% if @cases.any? %>
    <div class="space-y-4">
      <% @cases.each do |case_record| %>
        <div class="card bg-base-200 p-4 flex justify-between items-center">
          <div>
            <h3 class="font-semibold"><%= link_to case_record.case_name, case_path(case_record), class: "link link-primary" %></h3>
            <p class="text-sm">Deadline: <%= case_record.deadline.strftime('%B %d, %Y') %></p>
            <p class="text-sm">Days remaining: <%= (case_record.deadline - Date.today).to_i %></p>
          </div>
          <% if case_record.deadline < Date.today %>
            <span class="badge badge-error">Overdue</span>
          <% elsif case_record.deadline < Date.today + 7 %>
            <span class="badge badge-warning">Due Soon</span>
          <% else %>
            <span class="badge badge-success">On Track</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-base-content/60">No cases with deadlines set.</p>
  <% end %>
  <div class="mt-8">
    <%= link_to "Back to Cases", cases_path, class: "btn btn-ghost" %>
  </div>
</div>
