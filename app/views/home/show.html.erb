<div class="hero min-h-[calc(100vh-4rem)]">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">Draft Easy</h1>
      <p class="py-6">Your AI-powered legal drafting assistant. Upload, summarize, and generate legal drafts with ease.</p>
      <%= link_to "Get Started", (Current.user ? user_dashboard_path : sign_in_path), class: "btn btn-primary btn-lg" %>
      <div class="mt-6 flex flex-col gap-2">
        <%= link_to "Test In-App Notification", notify_test_path, class: "btn btn-secondary" %>
        <%= link_to "Test Email Notification", email_notify_test_path, class: "btn btn-accent" %>
      </div>
    </div>
  </div>
</div>
