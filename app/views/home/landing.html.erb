<%= render "shared/navbar" %>

<main class="bg-base-100">

  <!-- HERO -->
  <section class="hero min-h-screen bg-gradient-to-br from-base-100 to-base-200 px-4">
    <div class="hero-content text-center max-w-5xl flex flex-col gap-8">

      <%= image_tag "drafteasylogo.png",
        alt: "DraftEase Logo",
        class: "h-24 sm:h-28 md:h-32 mx-auto mb-4 rounded object-cover" %>

      <div class="badge badge-primary badge-lg mb-4">AI-Powered Legal Drafting</div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-primary leading-tight">
        Draft Awards & Judgments in Minutes
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl text-base-content/80 max-w-3xl mx-auto font-medium">
        Transform complex legal cases into professional drafts with AI assistance.
        Save hours on research, writing, and formatting while maintaining accuracy.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 mt-8">
        <%= link_to "Start Free Trial",
          sign_up_path,
          class: "btn btn-primary btn-lg w-full sm:w-auto px-8 py-4 text-lg" %>

        <%= link_to "Watch Demo",
          "#demo",
          class: "btn btn-outline btn-secondary btn-lg w-full sm:w-auto px-8 py-4 text-lg" %>
      </div>

      <div class="mt-12 text-sm text-base-content/60">
        Trusted by judges, lawyers, and legal professionals across Kenya
      </div>

    </div>
  </section>

  <!-- VALUE DELIVERY -->
  <section class="py-20 bg-base-100 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
        What DraftEase Delivers
      </h2>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <% [
          ["🔒", "Secure Document Uploads", "Encrypted storage with immutable originals and full audit trails."],
          ["🤖", "AI Summaries", "Structured, one-click summaries of facts, claims, and arguments."],
          ["📚", "Precedent Search", "Relevant case law from Kenya Law Reports and trusted public sources."],
          ["📝", "Draft Generation & Editing", "Professional draft awards tailored to your style, exportable to Word or PDF."],
          ["📁", "Case Management", "Create, track, and complete cases with deadlines in one place."]
        ].each do |icon, title, description| %>

          <div class="card bg-base-200 shadow-md hover:shadow-lg transition p-6 text-center">
            <div class="text-4xl mb-3"><%= icon %></div>
            <h3 class="font-semibold text-lg mb-2"><%= title %></h3>
            <p class="text-base-content/70"><%= description %></p>
          </div>

        <% end %>

      </div>
    </div>
  </section>

  <!-- SECURITY -->
  <section class="py-20 bg-base-200 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        Security & Confidentiality
      </h2>

      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 text-center">

        <div class="card bg-base-100 shadow p-6">
          <div class="text-4xl mb-2">🔒</div>
          <h3 class="font-semibold mb-2">End-to-End Encryption</h3>
          <p class="text-base-content/80">
            Data encrypted at rest and in transit.
          </p>
        </div>

        <div class="card bg-base-100 shadow p-6">
          <div class="text-4xl mb-2">🗂️</div>
          <h3 class="font-semibold mb-2">Private Workspaces</h3>
          <p class="text-base-content/80">
            Each drafter operates in a fully isolated environment.
          </p>
        </div>

        <div class="card bg-base-100 shadow p-6">
          <div class="text-4xl mb-2">📝</div>
          <h3 class="font-semibold mb-2">Audit Trails</h3>
          <p class="text-base-content/80">
            Full traceability for compliance and peace of mind.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="py-20 bg-base-100 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-10">
        Who DraftEase Is For
      </h2>

      <div class="flex flex-wrap justify-center gap-4">
        <span class="badge badge-lg badge-primary">Lawyers</span>
        <span class="badge badge-lg badge-secondary">Judges</span>
        <span class="badge badge-lg badge-accent">Arbitrators</span>
        <span class="badge badge-lg badge-neutral">Mediators</span>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="py-20 bg-base-200 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
        Simple, Transparent Pricing
      </h2>

      <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
        <% @plans.each do |plan| %>
          <div class="card bg-base-100 shadow-lg <%= plan.name == 'Pro' ? 'border-primary border-2' : '' %>">
            <div class="card-body">
              <h3 class="card-title text-2xl font-bold"><%= plan.name %></h3>
              <div class="text-4xl font-bold text-primary mb-2">
                USD <%= plan.amount / 100 %>
                <% if plan.amount > 0 %>
                  <span class="text-lg text-base-content/70">/<%= plan.interval %></span>
                <% end %>
              </div>
              <p class="text-base-content/70 mb-4"><%= plan.features %></p>
              <div class="flex gap-2 mb-2">
                <%= link_to 'See features', features_path(anchor: plan.name.parameterize), class: 'link' %>
              </div>
              <% if plan.name == 'Free' %>
                <%= link_to "Get Started",
                  sign_up_path,
                  class: "btn btn-outline btn-primary w-full" %>
              <% else %>
                <%= link_to "Start Free Trial",
                  sign_up_path,
                  class: "btn btn-primary w-full" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <p class="text-center text-base-content/70 mt-8">
        All plans include secure document storage, AI assistance, and 24/7 support.
      </p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t bg-base-100 px-4 py-10">
    <div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-3 items-center">

      <div class="flex items-center gap-3 justify-center md:justify-start">
        <%= image_tag "drafteasylogo.png",
          alt: "DraftEase Logo",
          class: "h-8 rounded-full object-cover" %>
        <span class="font-semibold text-lg">DraftEase</span>
      </div>

      <div class="flex justify-center gap-6">
        <%= link_to "Privacy", "#", class: "link link-hover" %>
        <%= link_to "Terms", "#", class: "link link-hover" %>
        <%= link_to "Contact", "#", class: "link link-hover" %>
      </div>

      <div class="text-sm text-base-content/70 text-center md:text-right">
        © <%= Time.current.year %> DraftEase. All rights reserved.
      </div>

    </div>
  </footer>

</main>
