<%= render "shared/breadcrumbs", current: @case.case_name.presence || "Case", parent: "Cases", parent_path: cases_path %>

<% if flash[:notice].present? %>
  <div class="max-w-2xl mx-auto mb-6 px-4">
    <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-green-800">
      <%= flash[:notice] %>
    </div>
  </div>
<% end %>

<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
    <h1 class="text-2xl font-semibold text-gray-900 mb-4"><%= @case.case_name %></h1>
    <div class="bg-gray-50 rounded-md border-l-4 border-primary px-4 py-3">
      <div class="flex flex-wrap gap-4 text-sm text-gray-600">
        <span><strong>Court:</strong> <%= @case.court %></span>
        <span><strong>Year:</strong> <%= @case.decision_year %></span>
        <span><strong>Jurisdiction:</strong> <%= @case.jurisdiction %></span>
        <span><strong>Type:</strong> <%= @case.case_type&.titleize %></span>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
    <div class="mb-4">
      <strong class="text-gray-700">Parties:</strong>
      <div class="mt-2 text-gray-600"><%= simple_format(@case.parties) %></div>
    </div>

    <div class="space-y-6">
      <% [
        ["Procedural History", @case.procedural_history],
        ["Facts", @case.facts],
        ["Legal Issue", @case.legal_issue],
        ["Holding", @case.holding],
        ["Rule of Law", @case.rule_of_law],
        ["Reasoning (Application)", @case.reasoning],
        ["Conclusion", @case.conclusion],
      ].each do |title, content| %>
        <% if content.present? %>
          <div>
            <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-2"><%= title %></h2>
            <div class="text-gray-600"><%= simple_format(content) %></div>
          </div>
        <% end %>
      <% end %>

      <% if @case.concurring_opinions.present? %>
        <div>
          <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-2">Concurring Opinions</h2>
          <div class="text-gray-600"><%= simple_format(@case.concurring_opinions) %></div>
        </div>
      <% end %>

      <% if @case.dissenting_opinions.present? %>
        <div>
          <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-2">Dissenting Opinions</h2>
          <div class="text-gray-600"><%= simple_format(@case.dissenting_opinions) %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Uploaded Document</h2>
    <div class="flex flex-wrap gap-3">
      <% if @case.document.attached? %>
        <%= link_to "Download Document", rails_blob_path(@case.document, disposition: "attachment", only_path: true), class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition", target: "_blank" %>
      <% else %>
        <span class="text-gray-500 text-sm">No document uploaded.</span>
      <% end %>
      <%= link_to "Download Case as PDF", download_pdf_case_path(@case), class: "bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700 transition" %>
      <%= button_to "Summarize", summarize_case_path(@case), method: :post, class: "bg-teal-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-teal-700 transition", form: { data: { turbo: false } } %>
      <% if @case.summary.present? %>
        <%= link_to "Download Summary", download_summary_case_path(@case), class: "bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-700 transition" %>
      <% end %>
    </div>
  </div>

  <% if @case.summary.present? %>
    <div class="bg-gray-50 rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">AI Summary</h2>
      <div class="prose prose-sm max-w-none">
        <%= simple_format(@case.summary.to_s.gsub(/\*\*(.+?)\*\*/, '<b>\\1</b>')).html_safe %>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6" id="precedents-section">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Search Kenya Law Precedents</h2>
    <%= form_with url: search_precedents_case_path(@case), method: :post, data: { turbo: true }, class: "flex gap-2 mb-4" do |f| %>
      <%= f.text_field :query, placeholder: "e.g., arbitration fairness", class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border" %>
      <%= f.submit "Search", class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
    <% end %>
    <%= render "precedents", precedents: @precedents || [], query: params[:query] %>
  </div>

  <% if @case.summary.present? %>
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Generate Draft</h2>
      <%= form_with url: generate_draft_case_path(@case), method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :draft_style, "Draft Style", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :draft_style, [["Formal Judgment", "formal"], ["Concise Legal", "concise"], ["Standard", "standard"]], class: "rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border w-full" %>
        </div>
        <div>
          <%= f.label :selected_precedents, "Selected Precedents (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :selected_precedents, placeholder: "Paste relevant precedent summaries here", class: "rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border w-full", rows: 3 %>
        </div>
        <%= f.submit "Generate Draft", class: "bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-700 transition", data: { disable_with: "Generating..." } %>
      <% end %>
    </div>
  <% end %>

  <% if @case.draft_content.present? %>
    <div class="bg-gray-50 rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Draft (<%= @case.draft_style&.titleize %>)</h2>
      <%= form_with model: @case, url: case_path(@case), method: :patch, local: true do |f| %>
        <%= f.rich_text_area :draft_content, class: "trix-content" %>
        <div class="flex gap-2 mt-4">
          <%= f.submit "Save Draft", class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
          <%= link_to "Export to PDF", download_pdf_case_path(@case), class: "bg-gray-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700 transition" %>
          <%= link_to "Export to Word", export_word_case_path(@case), class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @case.extracted_text.present? %>
    <div class="bg-gray-50 rounded-lg border border-gray-200 shadow-sm p-6 mb-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Extracted Text Preview</h2>
      <pre class="whitespace-pre-wrap text-sm text-gray-600"><%= truncate(@case.extracted_text, length: 500) %></pre>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-3 mt-8">
    <%= link_to "Back to Cases", cases_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
    <%= link_to "New Case", new_case_path, class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
    <%= link_to "Edit", edit_case_path(@case), class: "bg-teal-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-teal-700 transition" %>
    <%= button_to "Delete", case_path(@case), method: :delete, data: { confirm: "Are you sure you want to delete this case?" }, class: "bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-red-700 transition ml-auto" %>
  </div>
</div>
