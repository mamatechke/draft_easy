
<% if flash[:notice].present? %>
	<div class="alert alert-success mb-6">
		<%= flash[:notice] %>
	</div>
<% end %>


<div class="max-w-2xl mx-auto mt-10 p-8 bg-base-100 rounded-lg shadow">
	<h1 class="text-2xl font-bold mb-4"><%= @case.case_name %></h1>
	<div class="mb-4">
		<div class="card bg-base-200 rounded-lg shadow-sm p-3 flex flex-col sm:flex-row gap-2 sm:gap-6 text-base-content border-l-4 border-primary ml-[-1rem]">
			<span><strong>Court:</strong> <%= @case.court %></span>
			<span><strong>Year:</strong> <%= @case.decision_year %></span>
			<span><strong>Jurisdiction:</strong> <%= @case.jurisdiction %></span>
		</div>
	</div>
	<div class="mb-4">
		<strong>Citation:</strong> <%= @case.citation %>
	</div>
	<div class="prose max-w-none">
		<%# IRAC Method %>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Procedural History</h2>
		<p><%= simple_format(@case.procedural_history) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Facts</h2>
		<p><%= simple_format(@case.facts) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Legal Issue</h2>
		<p><%= simple_format(@case.legal_issue) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Holding</h2>
		<p><%= simple_format(@case.holding) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Rule of Law</h2>
		<p><%= simple_format(@case.rule_of_law) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Reasoning (Application)</h2>
		<p><%= simple_format(@case.reasoning) %></p>
		<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Conclusion</h2>
		<p><%= simple_format(@case.conclusion) %></p>
		<% if @case.concurring_opinions.present? %>
			  <h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Concurring Opinions</h2>
			<p><%= simple_format(@case.concurring_opinions) %></p>
		<% end %>
		<% if @case.dissenting_opinions.present? %>
			  s<h2 class="bg-secondary text-secondary-content px-4 py-2 rounded mb-2 inline-block border-l-4 border-primary ml-[-1rem]">Dissenting Opinions</h2>
			<p><%= simple_format(@case.dissenting_opinions) %></p>
		<% end %>
	</div>
	<!-- Uploaded Document Card -->
	<div class="card bg-base-100 shadow mb-6">
		<div class="card-body flex flex-col gap-2">
			<h2 class="card-title">Uploaded Document</h2>
			<div class="flex gap-2">
				<% if @case.document.attached? %>
					<%= link_to "Download Document", rails_blob_path(@case.document, disposition: "attachment", only_path: true), class: "btn btn-primary", target: "_blank" %>
				<% else %>
					<span class="text-base-content/60">No document uploaded.</span>
				<% end %>
				<%= link_to "Download Case as PDF", download_pdf_case_path(@case), class: "btn btn-secondary" %>
			</div>
		</div>
	</div>

	<% if @case.extracted_text.present? %>
		<div class="card bg-base-200 shadow mb-6">
			<div class="card-body">
				<h2 class="card-title">Extracted Text Preview</h2>
				<pre class="whitespace-pre-wrap text-sm"><%= truncate(@case.extracted_text, length: 500) %></pre>
			</div>
		</div>
	<% end %>

	<div class="flex gap-4 mt-8">
		<%= link_to "Back to Cases", cases_path, class: "btn btn-ghost" %>
		<%= link_to "New Case", new_case_path, class: "btn btn-primary" %>
		<%= link_to "Edit", edit_case_path(@case), class: "btn btn-accent" %>
		<%= button_to "Delete", case_path(@case), method: :delete, data: { confirm: "Are you sure you want to delete this case?" }, class: "btn btn-error ml-auto" %>
	</div>
</div>
