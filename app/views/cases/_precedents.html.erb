<% if precedents.present? %>
  <h2 class="text-lg font-medium text-gray-900 mb-4">Precedent Results (<%= precedents.size %> found)</h2>
  <div class="space-y-3">
    <% precedents.each do |p| %>
      <div class="bg-gray-50 rounded-lg border border-gray-200 p-4">
        <h3 class="font-medium"><%= link_to p[:title], p[:link], target: "_blank", class: "text-primary hover:text-purple-800" %></h3>
        <p class="text-sm text-gray-500 mt-1"><%= p[:summary] %></p>
        <div class="flex flex-wrap gap-2 mt-2">
          <% p[:tags].each do |tag| %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200"><%= tag %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% elsif query.present? %>
  <p class="text-gray-500 text-sm">No precedents found for "<%= query %>". Try a different search term.</p>
<% end %>
