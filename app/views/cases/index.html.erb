<!-- Breadcrumbs -->
<nav class="mb-6">
	<div class="card bg-base-200 shadow-sm p-2">
		<ul class="breadcrumbs flex items-center gap-2 text-sm m-0">
			<li><%= link_to 'Dashboard', dashboard_path, class: 'link link-hover' %></li>
			<li><svg class="inline w-4 h-4 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
			<li class="text-primary font-semibold">Cases</li>
		</ul>
	</div>
</nav>


<div class="max-w-4xl mx-auto mt-10">
	<div class="flex justify-between items-center mb-6">
		<h1 class="text-2xl font-bold">My Cases</h1>
		<%= link_to "New Case", new_case_path, class: "btn btn-primary" %>
	</div>
	<% if @cases.any? %>
		<div class="overflow-x-auto">
			<table class="table w-full">
				<thead>
					<tr>
						  <th>Case Name</th>
						<th>Court</th>
						<th>Year</th>
						<th>Jurisdiction</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<% @cases.each_with_index do |c, i| %>
						<tr class="even:bg-base-200 odd:bg-base-100">
							<td class="font-semibold">
								<%= c.case_name %>
								<% if c.created_at > 1.hour.ago %>
									<span class="badge badge-success ml-2">new</span>
								<% end %>
							</td>
							<td><%= c.court %></td>
							<td><%= c.decision_year %></td>
							<td><%= c.jurisdiction %></td>
							<td>
								<%= link_to "View", case_path(c), class: "btn btn-sm btn-outline" %>
							</td>
						</tr>
					<% end %>
				</tbody>
			</table>
		</div>
	<% else %>
		<div class="alert alert-info" style="background: linear-gradient(to right, #c7a8f4 0%, #e9f4f6 100%); color: #3b2562;">
		  No cases yet. <a class="link link-primary font-semibold" href="/cases/new">Create your first case</a>
		</div>
	<% end %>
</div>
