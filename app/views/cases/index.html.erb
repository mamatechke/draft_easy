<%= render "shared/breadcrumbs", current: "Cases" %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">My Cases</h1>
    <%= link_to "New Case", new_case_path, class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
  </div>

  <% if @cases.any? %>
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Case Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Court</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Year</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jurisdiction</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @cases.each do |c| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= c.case_name %>
                <% if c.created_at > 1.hour.ago %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">new</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= c.court %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= c.decision_year %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= c.jurisdiction %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to "View", case_path(c), class: "text-primary hover:text-purple-800 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3">
      No cases yet. <%= link_to "Create your first case", new_case_path, class: "text-primary hover:text-purple-800 font-medium" %>
    </div>
  <% end %>
</div>
