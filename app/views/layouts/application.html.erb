<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-[100vh-4rem]">
    <% unless controller_name == "home" && action_name == "landing" %>
      <%= render "shared/navbar" %>
    <% end %>
    <%= render "shared/flashes" %>
    <%= yield %>
    <%= turbo_stream_from Current.user if Current.user %>
  </body>
</html>
