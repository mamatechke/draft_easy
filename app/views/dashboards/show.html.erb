<div class="py-8">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">Dashboard</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
      <div class="text-sm font-medium text-gray-500 text-center">Total Cases</div>
      <div class="text-3xl font-bold text-primary text-center mt-1"><%= @stats[:total] %></div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
      <div class="text-sm font-medium text-gray-500 text-center">Cases This Month</div>
      <div class="text-3xl font-bold text-primary text-center mt-1"><%= @stats[:this_month] %></div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
      <div class="text-sm font-medium text-gray-500 text-center">Jurisdictions</div>
      <div class="text-3xl font-bold text-primary text-center mt-1"><%= @stats[:jurisdictions] %></div>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm mb-8">
    <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
      <h2 class="text-lg font-medium text-gray-900">Recent Cases</h2>
      <%= link_to "All Cases", cases_path, class: "text-sm text-primary hover:text-purple-800 font-medium" %>
    </div>
    <% if @recent_cases.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Case Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jurisdiction</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Year</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Updated</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @recent_cases.each do |c| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= c.case_name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= c.jurisdiction %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= c.decision_year %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= time_ago_in_words(c.updated_at) %> ago</td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                  <%= link_to "View", case_path(c), class: "text-primary hover:text-purple-800 font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center text-gray-500">
        No cases yet. <%= link_to "Create your first case", new_case_path, class: "text-primary hover:text-purple-800 font-medium" %>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-50 rounded-lg border border-gray-200 p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Quick Actions</h2>
    <div class="flex flex-col sm:flex-row gap-3">
      <button class="bg-gray-300 text-gray-500 px-4 py-2 rounded-md text-sm font-medium cursor-not-allowed" disabled>Upload Judgment</button>
    </div>
  </div>
</div>
