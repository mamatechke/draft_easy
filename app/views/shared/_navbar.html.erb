<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-14">
      <div class="flex items-center">
        <%= link_to(Current.user ? dashboard_path : root_path, class: "flex items-center") do %>
          <%= image_tag asset_path("drafteasylogo.png"), alt: "Draft Easy Logo", class: "h-8 w-auto" %>
        <% end %>
      </div>

      <div class="flex items-center">
        <% if Current.user && Current.session %>
          <div class="hidden md:flex items-center space-x-4">
            <%= link_to "Cases", cases_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
            <%= link_to "Deadlines", deadlines_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
            <%= link_to "Add New Case", new_case_path, class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
            
            <details class="relative" data-controller="dropdown">
              <summary class="cursor-pointer list-none focus:outline-none">
                <div class="h-8 w-8 bg-purple-100 rounded-full flex items-center justify-center">
                  <span class="text-purple-800 font-medium text-sm"><%= Current.user.email[0].upcase %></span>
                </div>
              </summary>
              <div class="absolute right-0 mt-2 w-40 bg-white rounded-md shadow-lg border border-gray-200 py-1 z-50">
                <%= link_to "Subscription", subscriptions_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <div class="border-t border-gray-100 my-1"></div>
                <%= button_to "Sign out", session_path(Current.session.id), method: :delete, data: { turbo_method: :delete }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              </div>
            </details>
          </div>

          <div class="md:hidden">
            <div class="relative" data-controller="dropdown">
              <button type="button" class="text-gray-600 hover:text-gray-900 p-2" data-action="dropdown#toggle">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
              </button>
              <div class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 py-1 z-50" data-dropdown-target="menu">
                <%= link_to "Cases", cases_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Deadlines", deadlines_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Add Case", new_case_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <div class="border-t border-gray-100 my-1"></div>
                <%= link_to "Subscription", subscriptions_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= button_to "Sign out", session_path(Current.session.id), method: :delete, data: { turbo_method: :delete }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="hidden md:flex items-center space-x-4">
            <%= link_to "Sign in", sign_in_path, class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
            <%= link_to "Sign up", sign_up_path, class: "bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-800 transition" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>
