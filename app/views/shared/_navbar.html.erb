<nav class="navbar bg-base-100 shadow mb-4">
  <div class="container mx-auto flex items-center justify-between py-2 px-4">
    <div class="flex items-center space-x-2">
      <%= link_to(Current.user ? dashboard_path : root_path, class: "btn btn-ghost no-animation flex items-center") do %>
        <%= image_tag asset_path("drafteasylogo.png"), alt: "Draft Easy Logo", class: "h-14 inline mr-2 align-middle rounded object-cover" %>
      <% end %>
    </div>

    <div class="flex items-center">
      <%# Determine sign-in route: prefer Devise if present, else fallback to app's sign_in_path %>
      <% route_helpers = Rails.application.routes.url_helpers %>
      <% sign_in_route = route_helpers.respond_to?(:new_user_session_path) ? route_helpers.new_user_session_path : sign_in_path %>

      <% if Current.user && Current.session %>
        <div class="hidden md:flex items-center space-x-3">
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-sm">Menu</div>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow">
              <li><%= link_to "Dashboard", dashboard_path %></li>
              <li><%= link_to "Cases", cases_path %></li>
              <li><%= link_to "Deadlines", deadlines_path %></li>
              <li><%= link_to "Subscription", subscriptions_path %></li>
            </ul>
          </div>
          <%= link_to "Add New Case Brief", new_case_path, class: "btn btn-primary btn-sm" %>
          <%= link_to "Sign out", session_path(Current.session.id), method: :delete, data: { turbo_method: :delete }, class: "btn btn-secondary btn-sm ml-2" %>
          <div class="avatar placeholder ml-2">
            <div class="bg-neutral text-neutral-content rounded-full w-8 border-2 border-primary">
              <span><%= Current.user.email[0].upcase %></span>
            </div>
          </div>
        </div>

        <%# Mobile dropdown for signed-in users %>
        <div class="md:hidden">
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-sm">☰</label>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-48 p-2 shadow">
              <li><%= link_to "Dashboard", dashboard_path %></li>
              <li><%= link_to "Cases", cases_path %></li>
              <li><%= link_to "Deadlines", deadlines_path %></li>
              <li><%= link_to "Subscription", subscriptions_path %></li>
              <li><%= link_to "Add Case", new_case_path %></li>
              <li><%= link_to "Sign out", session_path(Current.session.id), method: :delete, data: { turbo_method: :delete } %></li>
            </ul>
          </div>
        </div>
      <% else %>
        <div class="hidden md:flex items-center space-x-3">
          <%= link_to "Sign up", sign_up_path, class: "btn btn-primary btn-sm ml-2" %>
        </div>

        <%# Mobile dropdown for guests %>
        <div class="md:hidden">
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-sm">☰</label>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-40 p-2 shadow">
              <li><%= link_to "Sign up", sign_up_path %></li>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</nav>
