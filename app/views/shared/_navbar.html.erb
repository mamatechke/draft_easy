<nav class="navbar bg-base-100 shadow mb-4">
  <div class="container mx-auto flex items-center justify-between py-2 px-4">
    <div class="flex items-center space-x-2">
      <%= link_to(Current.user ? dashboard_path : root_path, class: "btn btn-ghost no-animation flex items-center") do %>
        <%= image_tag asset_path("drafteasylogo.png"), alt: "Draft Easy Logo", class: "h-14 inline mr-2 align-middle" %>
      <% end %>
    </div>
    <div class="flex items-center space-x-4">
      <% if Current.user && Current.session %>
        <%= link_to "Add New Case Brief", new_case_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "Sign out", session_path(Current.session.id), method: :delete, class: "btn btn-secondary btn-sm ml-2" %>
        <div class="avatar placeholder ml-2">
          <div class="bg-neutral text-neutral-content rounded-full w-8 border-2 border-primary">
            <span><%= Current.user.email[0].upcase %></span>
          </div>
        </div>
      <% else %>
        <%= link_to "Sign in", sign_in_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "Sign up", sign_up_path, class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>
  </div>
</nav>
