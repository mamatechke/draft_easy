<div class="max-w-md mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Dashboard", dashboard_path, class: "text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block" %>
    <% if Current.user.verified? %>
      <h1 class="text-3xl font-bold text-gray-900">Change Email</h1>
      <p class="text-gray-500 mt-1">Update your email address</p>
    <% else %>
      <h1 class="text-3xl font-bold text-gray-900">Verify Email</h1>
      <p class="text-gray-500 mt-1">Confirm your email address to get started</p>
    <% end %>
  </div>

  <% unless Current.user.verified? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <p class="text-blue-800 text-sm">We sent a verification email to your address. Check your inbox and follow the instructions.</p>
      <%= button_to "Resend Verification Email", identity_email_verification_path, class: "mt-3 text-sm text-primary hover:text-purple-800 font-medium" %>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
    <%= form_with(url: identity_email_path, method: :patch, class: "flex flex-col gap-4") do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-md px-4 py-3 text-red-800 text-sm">
          <h2 class="font-medium"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
          <ul class="mt-1 list-disc list-inside">
            <% @user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email, "New email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email, required: true, autofocus: true, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border" %>
      </div>

      <div>
        <%= form.label :password_challenge, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm px-3 py-2 border" %>
      </div>

      <%= form.submit "Update Email", class: "w-full bg-primary text-white py-2.5 px-4 rounded-md hover:bg-purple-800 transition font-medium mt-2" %>
    <% end %>
  </div>
</div>
