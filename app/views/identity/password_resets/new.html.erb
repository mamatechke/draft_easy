<div class="flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <%= image_tag asset_path("drafteasylogo.png"), alt: "DraftEasy Logo", class: "h-16 mx-auto mb-4" %>
      <h1 class="text-2xl font-bold text-gray-900">Forgot Password?</h1>
      <p class="text-gray-500 mt-1">Enter your email to reset your password</p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
      <%= form_with(url: identity_password_reset_path, class: "flex flex-col gap-4") do |form| %>
        <%= form.ui_email_field :email, label: :email, required: true, autofocus: true %>
        <%= form.ui_submit "Send Reset Link", class: "w-full bg-primary text-white py-2.5 px-4 rounded-md hover:bg-purple-800 transition font-medium" %>
      <% end %>
    </div>

    <div class="mt-6 text-center">
      <%= link_to "← Back to Sign In", sign_in_path, class: "text-sm text-primary hover:text-purple-800" %>
    </div>
  </div>
</div>
