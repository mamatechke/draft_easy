<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Analytics Dashboard</h1>
    <div class="flex gap-2">
      <a href="/blazer" target="_blank" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Blazer Analytics
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <p class="text-sm font-medium text-gray-500">Total Users</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_users %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <p class="text-sm font-medium text-gray-500">Total Cases</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_cases %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <p class="text-sm font-medium text-gray-500">Subscribed Users</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_subscribed %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <p class="text-sm font-medium text-gray-500">Active (7 days)</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_active_7_days %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">New Cases (Last 30 Days)</h2>
      <% if @daily_cases.any? %>
        <div class="space-y-2">
          <% @daily_cases.last(7).each do |data| %>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600"><%= data[:date].strftime("%b %d") %></span>
              <div class="flex-1 mx-4 bg-gray-200 rounded-full h-2">
                <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= (data[:count].to_f / @daily_cases.map { |c| c[:count] }.max * 100).to_i %>%"></div>
              </div>
              <span class="text-sm font-medium text-gray-900"><%= data[:count] %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No case data available</p>
      <% end %>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">New Signups (Last 30 Days)</h2>
      <% if @daily_signups.any? %>
        <div class="space-y-2">
          <% @daily_signups.last(7).each do |data| %>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600"><%= data[:date].strftime("%b %d") %></span>
              <div class="flex-1 mx-4 bg-gray-200 rounded-full h-2">
                <div class="bg-green-600 h-2 rounded-full" style="width: <%= (data[:count].to_f / @daily_signups.map { |c| c[:count] }.max * 100).to_i %>%"></div>
              </div>
              <span class="text-sm font-medium text-gray-900"><%= data[:count] %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No signup data available</p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Users</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Plan</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Joined</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @recent_users.each do |user| %>
              <tr>
                <td class="px-4 py-2 text-sm text-gray-900"><%= user.email %></td>
                <td class="px-4 py-2 text-sm text-gray-500"><%= user.plan&.name || "None" %></td>
                <td class="px-4 py-2 text-sm text-gray-500"><%= user.created_at.strftime("%b %d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Cases</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Case Name</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">User</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @recent_cases.each do |kase| %>
              <tr>
                <td class="px-4 py-2 text-sm text-gray-900"><%= kase.case_name || "Untitled" %></td>
                <td class="px-4 py-2 text-sm text-gray-500"><%= kase.user.email %></td>
                <td class="px-4 py-2 text-sm text-gray-500"><%= kase.created_at.strftime("%b %d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
